
# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id

# Optional: register slash commands to a single guild (faster for development)
# DISCORD_GUILD_ID=your_guild_id

# Spotify Web API credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Shared password between the bot and the Lavalink node
LAVALINK_PASSWORD=youshallnotpass

# YouTube OAuth refresh token from Lavalink logs after the device-login QR flow
# YOUTUBE_OAUTH_REFRESH_TOKEN=

# Lavalink connection
# - WSL / host `npm start`: use 127.0.0.1 (and publish port 2333 in compose)
# - Bot inside docker compose: use service name `lavalink`
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333

# When true, ephemeral Discord errors include the exception message
DEBUG=true

# Persisted player sessions (default /app/data/sessions.json in Docker)
# DATA_PATH=./data/sessions.json

# Leave voice when the bot is alone for this many milliseconds (default 5 minutes)
# IDLE_LEAVE_MS=300000

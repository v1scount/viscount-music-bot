# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id

# Optional: register slash commands to a single guild (faster for development)
# DISCORD_GUILD_ID=your_guild_id

# Premium Spotify account. Password login is often rejected by Spotify; when that
# happens the engine prints a one-time browser login URL instead.
SPOTIFY_USERNAME=your_spotify_username
SPOTIFY_PASSWORD=your_spotify_password

# Spotify engine. Defaults match a host `npm start` against the published loopback ports.
# Inside Compose the bot overrides these to the `spotify-engine` service.
SPOTIFY_ENGINE_URL=http://127.0.0.1:8090
SPOTIFY_PCM_HOST=127.0.0.1
SPOTIFY_PCM_PORT=8091

# When true, ephemeral Discord errors include the exception message
DEBUG=true

# Persisted player sessions (default /app/data/sessions.json in Docker)
# DATA_PATH=./data/sessions.json

# Leave voice when the bot is alone for this many milliseconds (default 5 minutes)
# IDLE_LEAVE_MS=300000
